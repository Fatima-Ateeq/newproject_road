# Copy this file to .env and edit the values. Never commit .env.

# PostgreSQL (the project's target database).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/roadwatch

# Quick start without installing PostgreSQL: use a local SQLite file instead.
# DATABASE_URL=sqlite:///./roadwatch.db

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional (defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# UPLOAD_DIR=uploads
# MAX_PHOTO_BYTES=5242880
# SUBMISSIONS_PER_HOUR=10   (complaints allowed per IP address per hour; raise it for demos)
# CORS_ORIGINS=["http://localhost:5173"]
# TRIAGE_MAX_TOOL_CALLS=5      (most tool calls the triage agent may make per complaint)
# TRIAGE_TIMEOUT_SECONDS=20   (time limit for the agent before the rule-based fallback takes over)
# TIMEZONE=Asia/Karachi        (day boundaries for the administrator's date filters)


# Gemini (the language model for the triage agent). Without both lines the system uses the rule-based fallback.
# GEMINI_API_KEY=            your key from Google AI Studio. Keep it private.
# GEMINI_MODEL=              a model name from:  python -m app.cli.try_llm --list-models
# GEMINI_THINKING_LEVEL=low  how long the model may reason (minimal, low, medium, high). Lower is faster
# LLM_TIMEOUT_SECONDS=30     how long to wait for one Gemini reply
